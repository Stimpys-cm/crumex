# INMOBILIARIA CRUMEX · variables de entorno
# En Vercel van en Settings > Environment Variables. Para probar en tu computadora,
# copia este archivo como .env.local y llena los valores (nunca subas .env.local a GitHub).

# Obligatorias
MONGODB_URI=
SETUP_TOKEN=

# Opcionales
MONGODB_DB=crumex
SITE_URL=

# Fotos y documentos en Cloudinary (si no las pones, se guardan en MongoDB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Avisos de prospectos y "¿Olvidaste tu contraseña?"
RESEND_API_KEY=
AVISO_EMAIL_TO=
AVISO_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
